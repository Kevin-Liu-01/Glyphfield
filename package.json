{
  "name": "glyphfield",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "analyze:dead-code": "knip",
    "analyze:duplicates": "jscpd --min-lines 12 --min-tokens 80 --threshold 0 --reporters console --format typescript,tsx --ignore '**/__tests__/**' src",
    "analyze:crap": "node scripts/check-crap.cjs",
    "analyze:halstead": "node scripts/check-halstead.cjs",
    "analyze:mutations": "stryker run",
    "build": "next build --turbopack",
    "build:ci": "next build",
    "build:prod": "next build --turbopack",
    "dev": "next dev --turbopack --port 3012",
    "docs:generate": "fumadocs-mdx",
    "lint": "pnpm lint:fast && pnpm lint:cognitive",
    "lint:cognitive": "eslint src --no-warn-ignored",
    "lint:fast": "oxlint src vitest.config.ts next.config.ts",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.all --coverage.include='src/**/*.{ts,tsx}' --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:coverage:strict": "vitest run --coverage --coverage.include='src/lib/{portableCanvasAssets,sourceCode}.ts' --coverage.reporter=text --coverage.reporter=json-summary --coverage.thresholds.100 --coverage.thresholds.perFile",
    "test:watch": "vitest",
    "typecheck": "fumadocs-mdx && tsc6 --noEmit"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-web": "^0.78.2",
    "@paper-design/shaders-react": "0.0.78",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slot": "^1.3.1",
    "@react-three/fiber": "^9.6.1",
    "@shadergradient/react": "2.4.20",
    "fumadocs-core": "16.12.0",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.12.0",
    "gifenc": "^1.0.3",
    "gt-next": "11.0.0-odysseus.15",
    "lucide-react": "^0.577.0",
    "mediabunny": "1.53.0",
    "next": "^16.2.10",
    "next-themes": "0.4.6",
    "prismjs": "^1.30.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadow-plugin": "^2.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "2.0.14",
    "@types/node": "24.5.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.9.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.6",
    "jscpd": "^5.0.16",
    "knip": "^6.34.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "ts-complex": "1.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.1.4"
  }
}
